FRONTEND_EXTERNAL_PORT=8080
BACKEND_EXTERNAL_PORT=8081

# Number of Gunicorn workers.
# =========================================================
WORKERS=6

POSTGRES_PASSWORD="postgres"
POSTGRES_USER="postgres"
POSTGRES_DB="asreview_db"

# Keycloak / oauth2-proxy
# =========================================================
# Copy the values below into oauth2-proxy.cfg (they are not read from here
# automatically; .cfg is the native config file for oauth2-proxy).
#
# KEYCLOAK_URL=https://sso.example.org
# KEYCLOAK_REALM=reviewsuite
# OAUTH2_PROXY_CLIENT_ID=asreview
# OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME
# OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_32_BYTES   # openssl rand -base64 32
# APP_URL=https://review.example.org
